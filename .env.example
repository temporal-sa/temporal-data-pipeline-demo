# Temporal Configuration

# Task queue the pipeline workflows run on (each worker also serves a
# host-specific queue derived from it)
TEMPORAL_TASK_QUEUE=data-pipeline

# Optional: Payload Encryption
# Set to 'true' to enable payload encryption, 'false' or omit to disable
ENCRYPT_PAYLOADS=false

# Temporal connection
# Read by the Temporal SDK's environment configuration. Leave them unset to
# connect to a local dev server at localhost:7233, namespace "default".
# TEMPORAL_ADDRESS=your-namespace.abc123.tmprl.cloud:7233
# TEMPORAL_NAMESPACE=your-namespace.abc123
# TEMPORAL_API_KEY=your-api-key
# TEMPORAL_TLS=true
# For mTLS instead of an API key:
# TEMPORAL_TLS_CLIENT_CERT_PATH=/path/to/client.pem
# TEMPORAL_TLS_CLIENT_KEY_PATH=/path/to/client.key

# Temporal UI the web app links each job to
# TEMPORAL_UI_URL=http://localhost:8233
